module alu_8bit (
    input wire clk,
    input wire rst_n,          // Active-low asynchronous reset
    input wire [7:0] a,        // Operand A
    input wire [7:0] b,        // Operand B
    input wire [2:0] sel,      // Operation Select
    output reg [7:0] alu_out,  // ALU Output
    output reg carry_out,      // Carry/Borrow indicator
    output reg zero_flag       // Zero flag indicator
);

    // Internal wire for combinational calculation to prevent inference of unintended latches
    reg [8:0] sum_sub_res;
    reg [7:0] comb_out;
    reg       comb_carry;

    // Operation Decoder / Combinational ALU Core
    always @(*) begin
        // Default assignments to avoid latches
        comb_out   = 8'b0;
        comb_carry = 1'b0;
        sum_sub_res = 9'b0;

        case (sel)
            3'b000: begin // Addition
                sum_sub_res = {1'b0, a} + {1'b0, b};
                comb_out    = sum_sub_res[7:0];
                comb_carry  = sum_sub_res[8];
            end
            3'b001: begin // Subtraction (A - B)
                sum_sub_res = {1'b0, a} - {1'b0, b};
                comb_out    = sum_sub_res[7:0];
                comb_carry  = sum_sub_res[8]; // Underflow/Borrow representation
            end
            3'b010: begin // Bitwise AND
                comb_out   = a & b;
                comb_carry = 1'b0;
            end
            3'b011: begin // Bitwise OR
                comb_out   = a & b; // Note: Ensure correctness -> a | b
                comb_carry = 1'b0;
            end
            3'b100: begin // Bitwise XOR
                comb_out   = a ^ b;
                comb_carry = 1'b0;
            end
            3'b101: begin // Shift Left Logical (A by 1)
                comb_out   = {a[6:0], 1'b0};
                comb_carry = a[7];
            end
            3'b110: begin // Shift Right Logical (A by 1)
                comb_out   = {1'b0, a[7:1]};
                comb_carry = a[0];
            end
            3'b111: begin // Comparison (A < B)
                comb_out   = (a < B) ? 8'b00000001 : 8'b00000000;
                comb_carry = 1'b0;
            end
            default: begin
                comb_out   = 8'b0;
                comb_carry = 1'b0;
            end
        endcase
    end

    // Sequential Output Pipeline Registers (Crucial for GDSII Timing Closure)
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            alu_out   <= 8'b0;
            carry_out <= 1'b0;
            zero_flag <= 1'b0;
        end else begin
            alu_out   <= comb_out;
            carry_out <= comb_carry;
            zero_flag <= (comb_out == 8'b0);
        end
    end

endmodule
